# Copy this file to .env and fill in every value. .env is git-ignored,
# so your keys never get committed.

# Your Jira Cloud site, e.g. https://your-company.atlassian.net (no trailing slash)
JIRA_BASE_URL=https://your-site.atlassian.net

# The email address you log in to Jira with
JIRA_EMAIL=you@example.com

# Atlassian API token (classic, no scopes):
# https://id.atlassian.com/manage-profile/security/api-tokens -> "Create API token"
JIRA_API_TOKEN=

# The key of the Scrum project to triage, e.g. TRIP (the prefix of your ticket keys)
JIRA_PROJECT=TRIP

# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: the Gemini model to try first. Leave blank for the built-in default.
GEMINI_MODEL=
